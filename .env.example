# Copy to .env and adjust. Every setting has a sensible default.

# Keep true in production (the app must be served over HTTPS). Only set false for local testing on http://localhost.
COOKIE_SECURE=true

# How many days a child stays signed in on a device without using the app.
SESSION_DAYS=90

# Minimum password length for new passwords (children: 6 is a reasonable floor).
MIN_PASSWORD_LENGTH=6

# Per network address. A whole class on one church Wi-Fi shares an address, so keep these generous.
SIGNUPS_PER_HOUR_PER_IP=60
LOGINS_PER_15MIN_PER_IP=300

# Where the SQLite database is stored (the Docker image uses /data).
# DATA_DIR=/data
# PORT=3000

# Behind a reverse proxy (Caddy, nginx, a cloud load balancer): how many proxy hops to trust.
# TRUST_PROXY=1
